# Copy to .env (gitignored). Read by docker compose and by the Playwright configs; CI uses GitHub secrets instead.
# Values live in 1Password. Do not commit them or paste them into chat.

# Local stack. Change MM_PORT if 8065 is taken by another Mattermost; use an arm64 image on Apple Silicon.
# The real lane needs MM_PORT to match the callback URL registered in the Atlassian OAuth app (8070).
MM_PORT=8065
MM_IMAGE=mattermostdevelopment/mattermost-enterprise-edition:master

# Real Confluence Cloud (`make e2e-real`, `npm run real:login`). Same Atlassian site and accounts as the Jira suite.
CONFLUENCE_CLOUD_URL=https://your-site.atlassian.net
CONFLUENCE_SPACE_KEY=

# Regular Confluence user on the test site
CONFLUENCE_CLOUD_USER_EMAIL=

# The regular user's Atlassian password and two-step verification setup key (`make e2e-real`, `npm run real:login`).
# TOTP secret = the key behind "Can't scan the QR code?" when enrolling an authenticator app at id.atlassian.com.
CONFLUENCE_CLOUD_USER_PASSWORD=
CONFLUENCE_CLOUD_USER_TOTP_SECRET=

# Atlassian OAuth 2.0 (3LO) app with the Confluence scopes, owned by the admin account
CONFLUENCE_CLOUD_OAUTH_CLIENT_ID=
CONFLUENCE_CLOUD_OAUTH_CLIENT_SECRET=
